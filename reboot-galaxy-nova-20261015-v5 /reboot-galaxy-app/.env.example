# ===== Reboot Galaxy NOVA 設定ファイルの見本 =====
# 使うときは、このファイルを .env という名前でコピーして書き換えてください。
# 何も設定しなくてもアプリは動きます（決済なし・メールとパスワードのログインのみ）。

# 画面を開くときのポート番号（使用中なら自動で次の番号を使います）
PORT=3000

# ログイン画面の「デモアカウントで試す」を隠す（公開の場で使うとき）
# RG_HIDE_DEMO=1

# ----- Googleログインを使う場合 -----
# Google Cloud Console → APIとサービス → 認証情報 → OAuth クライアント ID（ウェブアプリケーション）
# 「承認済みのリダイレクト URI」に次を登録してください：
#   http://localhost:3000/auth/google/callback
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# ※ この展示版の購入・返金・加入は記録だけです。Stripe などの外部決済には接続しません。
